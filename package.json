{
  "name": "kids-abc-learning",
  "version": "1.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist",
    "build:android": "expo export --platform android --output-dir build/android",
    "serve:test": "node scripts/serve-web.mjs",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "check": "npm run format:check && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-audio": "~58.0.11",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
